<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.PostMapper">
    <select id="selectAll" resultType="com.example.entity.Post">
        select * from `post`
        <where>
            <if test="id != null"> and id = #{id}</if>
            <if test="title != null"> and title like concat('%', #{title}, '%')</if>
            <if test="category != null"> and category = #{category}</if>
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="status != null"> and status = #{status}</if>
        </where>
        order by is_top desc, id desc
    </select>
    <select id="selectById" resultType="com.example.entity.Post">
        select * from `post` where id = #{id}
    </select>
    <delete id="deleteById">delete from `post` where id = #{id}</delete>
    <insert id="insert" parameterType="com.example.entity.Post" useGeneratedKeys="true" keyProperty="id">
        insert into `post` <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null">title,</if>
            <if test="content != null">content,</if>
            <if test="category != null">category,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null">user_name,</if>
            <if test="userAvatar != null">user_avatar,</if>
            <if test="viewCount != null">view_count,</if>
            <if test="likeCount != null">like_count,</if>
            <if test="replyCount != null">reply_count,</if>
            <if test="isTop != null">is_top,</if>
            <if test="isEssence != null">is_essence,</if>
            <if test="status != null">status,</if>
            <if test="time != null">time,</if>
        </trim> values <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null">#{title},</if>
            <if test="content != null">#{content},</if>
            <if test="category != null">#{category},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userName != null">#{userName},</if>
            <if test="userAvatar != null">#{userAvatar},</if>
            <if test="viewCount != null">#{viewCount},</if>
            <if test="likeCount != null">#{likeCount},</if>
            <if test="replyCount != null">#{replyCount},</if>
            <if test="isTop != null">#{isTop},</if>
            <if test="isEssence != null">#{isEssence},</if>
            <if test="status != null">#{status},</if>
            <if test="time != null">#{time},</if>
        </trim>
    </insert>
    <update id="updateById" parameterType="com.example.entity.Post">
        update `post` <set>
            <if test="title != null">title = #{title},</if>
            <if test="content != null">content = #{content},</if>
            <if test="category != null">category = #{category},</if>
            <if test="viewCount != null">view_count = #{viewCount},</if>
            <if test="likeCount != null">like_count = #{likeCount},</if>
            <if test="replyCount != null">reply_count = #{replyCount},</if>
            <if test="isTop != null">is_top = #{isTop},</if>
            <if test="isEssence != null">is_essence = #{isEssence},</if>
            <if test="status != null">status = #{status},</if>
        </set> where id = #{id}
    </update>
    <update id="incrementViewCount">
        update `post` set view_count = ifnull(view_count, 0) + 1 where id = #{id}
    </update>
    <update id="incrementLikeCount">
        update `post` set like_count = ifnull(like_count, 0) + 1 where id = #{id}
    </update>
    <update id="decrementLikeCount">
        update `post` set like_count = greatest(ifnull(like_count, 0) - 1, 0) where id = #{id}
    </update>
    <update id="incrementReplyCount">
        update `post` set reply_count = ifnull(reply_count, 0) + 1 where id = #{id}
    </update>
    <update id="decrementReplyCount">
        update `post` set reply_count = greatest(ifnull(reply_count, 0) - 1, 0) where id = #{id}
    </update>
</mapper>