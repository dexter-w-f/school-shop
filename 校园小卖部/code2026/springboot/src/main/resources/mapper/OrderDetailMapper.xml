<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.OrderDetailMapper">

    <select id="selectAll" resultType="com.example.entity.OrderDetail">
        select * from `order_detail`
        <where>
            <if test="orderId != null"> order_id = #{orderId}</if>
        </where>
        order by id desc
    </select>

    <select id="selectById" resultType="com.example.entity.OrderDetail">
        select * from `order_detail` where id = #{id}
    </select>

    <delete id="deleteById">
        delete from `order_detail` where id = #{id}
    </delete>

    <insert id="insert" parameterType="com.example.entity.OrderDetail" useGeneratedKeys="true">
        insert into `order_detail`
        <trim prefix="(" suffix=" )" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="num != null">num,</if>
            <if test="orderId != null">order_id,</if>
            <if test="goodsImg != null">goods_img,</if>
            <if test="goodsName != null">goods_name,</if>
            <if test="goodsPrice != null">goods_price,</if>
        </trim>
        values
        <trim prefix="(" suffix=" )" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="goodsId != null">#{goodsId},</if>
            <if test="num != null">#{num},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="goodsImg != null">#{goodsImg},</if>
            <if test="goodsName != null">#{goodsName},</if>
            <if test="goodsPrice != null">#{goodsPrice},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.OrderDetail">
        update `order_detail`
        <set>
            <if test="id != null">
                id = #{id},
            </if>
           <if test="goodsId != null">
                goods_id = #{goodsId},
            </if>
            <if test="num != null">
                num = #{num},
            </if>
            <if test="orderId != null">
                order_id = #{orderId},
            </if>
            <if test="goodsImg != null">
                goods_img = #{goodsImg},
            </if>
            <if test="goodsName != null">
                goods_name = #{goodsName},
            </if>
            <if test="goodsPrice != null">
                goods_price = #{goodsPrice},
            </if>
        </set>
        where id = #{id}
    </update>

    <select id="selectCategoryAmountGroup" resultType="map">
        <!-- 按明细金额汇总：若用 sum(o.total) 会随明细行数重复累加，导致统计虚高 -->
        select g.category_id as categoryId, c.name as categoryName,
               ifnull(sum(od.goods_price * od.num), 0) as amount
        from `order_detail` od
        join `goods` g on g.id = od.goods_id
        join `category` c on c.id = g.category_id
        join `orders` o on o.id = od.order_id
        <where>
            <if test="orderIds != null and orderIds.size() > 0">
                and od.order_id in
                <foreach collection="orderIds" item="orderId" open="(" separator="," close=")">
                    #{orderId}
                </foreach>
            </if>
            and o.status != '已取消'
        </where>
        group by g.category_id, c.name
    </select>

</mapper>
