<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.RefundOrdersMapper">

    <select id="selectAll" resultType="com.example.entity.RefundOrders">
        select refund_orders.*, user.name as user_name from `refund_orders`
        left join user on refund_orders.user_id = user.id
        <where>
            <if test="id != null"> and refund_orders.id = #{id}</if>
            <if test="orderId != null"> and refund_orders.order_id = #{orderId}</if>
            <if test="orderNo != null"> and refund_orders.order_no like concat('%', #{orderNo}, '%')</if>
            <if test="userId != null"> and refund_orders.user_id = #{userId}</if>
            <if test="status != null"> and refund_orders.status = #{status}</if>
            <if test="type != null"> and refund_orders.type = #{type}</if>
        </where>
        order by refund_orders.id desc
    </select>

    <select id="selectById" resultType="com.example.entity.RefundOrders">
        select * from `refund_orders` where id = #{id}
    </select>

    <delete id="deleteById">
        delete from `refund_orders` where id = #{id}
    </delete>

    <insert id="insert" parameterType="com.example.entity.RefundOrders" useGeneratedKeys="true" keyProperty="id">
        insert into `refund_orders`
        <trim prefix="(" suffix=" )" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="orderId != null">order_id,</if>
            <if test="orderNo != null">order_no,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null">user_name,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="goodsName != null">goods_name,</if>
            <if test="goodsImg != null">goods_img,</if>
            <if test="amount != null">amount,</if>
            <if test="type != null">type,</if>
            <if test="reason != null">reason,</if>
            <if test="description != null">description,</if>
            <if test="images != null">images,</if>
            <if test="status != null">status,</if>
            <if test="reply != null">reply,</if>
            <if test="time != null">time,</if>
            <if test="handleTime != null">handle_time,</if>
        </trim>
        values
        <trim prefix="(" suffix=" )" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="orderId != null">#{orderId},</if>
            <if test="orderNo != null">#{orderNo},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userName != null">#{userName},</if>
            <if test="goodsId != null">#{goodsId},</if>
            <if test="goodsName != null">#{goodsName},</if>
            <if test="goodsImg != null">#{goodsImg},</if>
            <if test="amount != null">#{amount},</if>
            <if test="type != null">#{type},</if>
            <if test="reason != null">#{reason},</if>
            <if test="description != null">#{description},</if>
            <if test="images != null">#{images},</if>
            <if test="status != null">#{status},</if>
            <if test="reply != null">#{reply},</if>
            <if test="time != null">#{time},</if>
            <if test="handleTime != null">#{handleTime},</if>
        </trim>
    </insert>

    <update id="updateById" parameterType="com.example.entity.RefundOrders">
        update `refund_orders`
        <set>
            <if test="orderId != null">order_id = #{orderId},</if>
            <if test="orderNo != null">order_no = #{orderNo},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="goodsName != null">goods_name = #{goodsName},</if>
            <if test="goodsImg != null">goods_img = #{goodsImg},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="type != null">type = #{type},</if>
            <if test="reason != null">reason = #{reason},</if>
            <if test="description != null">description = #{description},</if>
            <if test="images != null">images = #{images},</if>
            <if test="status != null">`status` = #{status},</if>
            <if test="reply != null">reply = #{reply},</if>
            <if test="time != null">time = #{time},</if>
            <if test="handleTime != null">handle_time = #{handleTime},</if>
        </set>
        where id = #{id}
    </update>

    <update id="updateStatusIfApproved">
        update `refund_orders`
        set status = #{status}
        where id = #{id} and status = '已通过'
    </update>
</mapper>
