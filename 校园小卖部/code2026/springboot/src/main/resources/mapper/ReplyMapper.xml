<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.mapper.ReplyMapper">
    <select id="selectAll" resultType="com.example.entity.Reply">
        select r.*, (select user_name from reply where id = r.parent_id) as parent_name
        from `reply` r
        <where>
            <if test="id != null"> and r.id = #{id}</if>
            <if test="postId != null"> and r.post_id = #{postId}</if>
            <if test="userId != null"> and r.user_id = #{userId}</if>
        </where>
        order by r.id asc
    </select>
    <select id="selectById" resultType="com.example.entity.Reply">
        select * from `reply` where id = #{id}
    </select>
    <delete id="deleteById">delete from `reply` where id = #{id}</delete>
    <delete id="deleteByPostId">delete from `reply` where post_id = #{postId}</delete>
    <insert id="insert" parameterType="com.example.entity.Reply" useGeneratedKeys="true" keyProperty="id">
        insert into `reply` <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="postId != null">post_id,</if>
            <if test="content != null">content,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null">user_name,</if>
            <if test="userAvatar != null">user_avatar,</if>
            <if test="parentId != null">parent_id,</if>
            <if test="time != null">time,</if>
        </trim> values <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="postId != null">#{postId},</if>
            <if test="content != null">#{content},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userName != null">#{userName},</if>
            <if test="userAvatar != null">#{userAvatar},</if>
            <if test="parentId != null">#{parentId},</if>
            <if test="time != null">#{time},</if>
        </trim>
    </insert>
</mapper>